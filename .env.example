# Copy to .env (make up does this for you if .env is missing).
# Local development values only - nothing here is a secret. Never put real PHI or credentials here.

APP_ENV=local

# Postgres container
POSTGRES_USER=casecompass
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=casecompass
POSTGRES_PORT=5432

# Backend. docker-compose overrides the host to "db" inside the container;
# this value is used when running the backend or Alembic from your machine.
DATABASE_URL=postgresql+psycopg://casecompass:change-me-local-only@localhost:5432/casecompass
BACKEND_PORT=8000

# fixed = reference clock 2026-11-09T08:00 America/New_York (tests and demo); system = wall clock
CLOCK_MODE=fixed

# Frontend dev server proxies /api/* to this backend URL.
VITE_API_PROXY_TARGET=http://localhost:8000

# Demo-grade JWT signing key for the fake login. Local placeholder, not a secret.
# At least 32 characters (HS256).
JWT_SECRET=dev-only-local-placeholder-not-a-real-secret

# Mock CM platform the write-back client syncs to (make up starts it on 8200).
MOCK_CM_URL=http://localhost:8200

# AI note draft in the Live pane. DEMO_MODE=true switches it on for every pod; in a pilot set
# DEMO_MODE=false and list the pods it is on for, e.g. AI_DRAFT_PODS=["OH-1"]. Without a key
# (or an `ant auth login` profile) the panel says "AI draft unavailable" and nurses write as usual.
DEMO_MODE=true
AI_DRAFT_PODS=[]
AI_DRAFT_MODEL=claude-opus-5-5
# ANTHROPIC_API_KEY=
